# ======================
# ОСНОВНЫЕ НАСТРОЙКИ ПРИЛОЖЕНИЯ
# ======================
APP_NAME="Laravel Vue Admin Fenix"
APP_KEY=base64:gv0JyO1nYSQpk5cxrdXTLjZfz9+NJMc39NKJ+TnHLwk=
APP_URL=http://94.41.87.10
APP_URL_PORT=

# ======================
# НАСТРОЙКИ OPEN SERVER
# ======================
OPEN_SERVER_PORT=8050
OPEN_SERVER_IP=192.168.88.249

# ======================
# РЕЖИМ РАБОТЫ ПРИЛОЖЕНИЯ
# ======================
APP_ENV=production
APP_DEBUG=true

# ======================
# BUILD MODE (fast/size/dev)
# ======================
BUILD_MODE=size

# ======================
# НАСТРОЙКИ БАЗЫ ДАННЫХ
# ======================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel-vue-admin-fenix
DB_USERNAME=root
DB_PASSWORD=

# ======================
# НАСТРОЙКИ КЭША И ОЧЕРЕДЕЙ
# ======================
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=43200
REDIS_HOST=127.0.0.1
REDIS_CLIENT=predis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ======================
# НАСТРОЙКИ ПОЧТЫ
# ======================
MAIL_MAILER=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@fenixlaravel.com
MAIL_FROM_NAME="${APP_NAME}"

# ======================
# НАСТРОЙКИ ФАЙЛОВОЙ СИСТЕМЫ
# ======================
FILESYSTEM_DRIVER=public

# ======================
# НАСТРОЙКИ ОТЛАДКИ И ЛОГИРОВАНИЯ
# ======================
LOG_CHANNEL=stack
LOG_LEVEL=error
XDEBUG_MODE=off

# ======================
# НАСТРОЙКИ VITE (FRONTEND)
# ======================
VITE_BASE_PATH=/build/
VITE_APP_ENV="${APP_ENV}"
VITE_API_BASE_URL=http://94.41.87.10:8050/api/
VITE_APP_URL=http://94.41.87.10:8050/
VITE_APP_HOST=94.41.87.10
SANCTUM_CSRF_ENDPOINT=http://94.41.87.10/sanctum/csrf-cookie

# ======================
# НАСТРОЙКИ АУТЕНТИФИКАЦИИ (SANCTUM) И CORS
# ======================
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN_AUTO=false
SESSION_DOMAIN=94.41.87.10
SANCTUM_STATEFUL_DOMAINS=fenixlaravel.loc,94.41.87.10:8050,94.41.87.10:8080,94.41.87.10,localhost,localhost:5173,192.168.88.249,127.0.0.1

# ======================
# ALLOWED ORIGINS (CORS)
# ======================
ALLOWED_ORIGINS="http://fenixlaravel.loc,http://fenixlaravel.loc:8080,http://fenixlaravel.loc:8050,http://127.0.0.1,http://94.41.87.10,http://94.41.87.10:80,http://94.41.87.10:8050,http://94.41.87.10:8080,http://94.41.87.10:5173,http://localhost:5173,http://192.168.88.249"

# ======================
# НАСТРОЙКИ BROADCASTING (WEBSOCKETS)
# ======================
BROADCAST_CONNECTION=reverb
BROADCAST_DRIVER=reverb

# ======================
# REVERB SERVER CONFIG
# ======================
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_SERVER_PATH=/reverb
REVERB_APP_ID=123434236212
REVERB_APP_KEY=base64:gv0JyO1nYSQpk5cxrdXTLjZfz9+NJMc39NKJ+TnHLwk=
REVERB_APP_SECRET=base64:gv0JyO1nYSQpk5cxrdXTLjZfz9+NJMc39NKJ+TnHLwk=

# ======================
# REVERB CLIENT CONFIG (Production)
# ======================
REVERB_HOST=94.41.87.10
REVERB_PORT=80
REVERB_SCHEME=ws
REVERB_PATH=/reverb

# ======================
# VITE REVERB CONFIG (Client-side Production)
# ======================
VITE_LOG_LEVEL=error
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=94.41.87.10
VITE_REVERB_PORT=80
VITE_REVERB_PATH="${REVERB_SERVER_PATH}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_REVERB_AUTH_ENDPOINT=/broadcasting/auth

# ======================
# СОВМЕСТИМОСТЬ С PUSHER (для старых клиентов)
# ======================
PUSHER_APP_ID=reverb_app_main-1
PUSHER_APP_KEY=reverb_app_key_public-1212
PUSHER_APP_SECRET=reverb_app_secret_private-123
PUSHER_APP_CLUSTER=mt1

# ======================
# LARAVEL MIX (для сборки)
# ======================
MIX_PUSHER_APP_KEY="reverb_app_key_public-1212"
MIX_PUSHER_APP_CLUSTER="reverb"

# ======================
# PANTHER (Chrome Driver)
# ======================
PANTHER_CHROME_DRIVER_BINARY="public/chromedriver_64.exe"
PANTHER_NO_SANDBOX=true
PANTHER_BROWSER=chrome
PANTHER_WEB_SERVER_DIR=public
PANTHER_CHROME_ARGUMENTS=""

# ======================
# FFprobe
# ======================
FFPROBE_BINARIES=ffprobe

# ======================
# Video Scanner
# ======================
VIDEO_FFPROBE_LIMIT=500
VIDEO_CACHE_TTL=1800
VIDEO_SORT_BY=modified
VIDEO_SORT_DIRECTION=desc
VIDEO_MAX_PROCESSING_TIME=300

# ======================
# SmartLight Settings
# ======================
SMART_LIGHT_DEFAULT_CRITICAL_VOLTAGE=3.2
SMART_LIGHT_DEFAULT_SLEEP_INTERVAL=600
SMART_LIGHT_DEFAULT_EMERGENCY_SLEEP_INTERVAL=3600
