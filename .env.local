# ======================
# LARAVEL MIX
# ======================
MIX_PUSHER_APP_KEY="reverb_app_key_public"
MIX_PUSHER_APP_CLUSTER="reverb"

# ======================
# PANTHER (CHROME DRIVER)
# ======================
PANTHER_CHROME_DRIVER_BINARY="public/chromedriver_64.exe"
PANTHER_NO_SANDBOX=true
PANTHER_BROWSER=chrome
PANTHER_WEB_SERVER_DIR=public
PANTHER_CHROME_ARGUMENTS=""

# ======================
# FFPROBE
# ======================
FFPROBE_BINARIES=ffprobe

# ======================
# VIDEO SCANNER
# ======================
VIDEO_FFPROBE_LIMIT=500
VIDEO_CACHE_TTL=1800
VIDEO_SORT_BY=modified
VIDEO_SORT_DIRECTION=desc
VIDEO_MAX_PROCESSING_TIME=300

# ======================
# SMARTLIGHT SETTINGS
# ======================
SMART_LIGHT_DEFAULT_CRITICAL_VOLTAGE=3.2
SMART_LIGHT_DEFAULT_SLEEP_INTERVAL=600
SMART_LIGHT_DEFAULT_EMERGENCY_SLEEP_INTERVAL=3600
