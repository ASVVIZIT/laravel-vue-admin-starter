MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=local@fenixlaravel.loc
MAIL_FROM_NAME="${APP_NAME}"

# ======================
# ФАЙЛОВАЯ СИСТЕМА
# ======================
FILESYSTEM_DRIVER=local

# ======================
# НАСТРОЙКИ ОТЛАДКИ
# ======================
