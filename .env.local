# ======================
# Общие настройки приложения
# ======================
APP_NAME="Laravel Vue Admin Fenix (Local)"
APP_KEY=base64:gv0JyO1nYSQpk5cxrdXTLjZfz9+NJMc39NKJ+TnHLwk=
APP_URL=http://fenixlaravel.loc:3000

# ======================
# Настройки Open Server
# ======================
OPEN_SERVER_PORT=3000
OPEN_SERVER_IP=192.168.88.249

# ======================
# Режимы работы
# ======================
APP_ENV=local
APP_DEBUG=true

# ======================
# Настройки базы данных
# ======================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel-vue-admin-fenix
DB_USERNAME=root
DB_PASSWORD=

# ======================
# Кэш и очереди
# ======================
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=43200 # 30 дней

REDIS_HOST=127.0.0.1
REDIS_CLIENT=predis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ======================
# Настройки почты
# ======================
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=local@fenixlaravel.loc
MAIL_FROM_NAME="${APP_NAME}"

# ======================
# Файловая система
# ======================
FILESYSTEM_DRIVER=local

# ======================
# Настройки отладки
# ======================
LOG_CHANNEL=daily
LOG_LEVEL=debug
XDEBUG_MODE=develop,debug

# ======================
# Vite-конфигурация
# ======================
VITE_BASE_PATH=/build/
VITE_API_BASE_URL=http://fenixlaravel.loc/api/
VITE_APP_URL=http://fenixlaravel.loc:5173
VITE_APP_ENV="${APP_ENV}"

# ======================
# Другие сервисы Sanctum и CORS
# ======================
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN_AUTO=false
SANCTUM_STATEFUL_DOMAINS="fenixlaravel.loc,localhost"
ALLOWED_ORIGINS="http://fenixlaravel.loc:5173 http://fenixlaravel.loc:3000 http://fenixlaravel.loc:8070 http://fenixlaravel.loc:80 http://localhost:3000 http://fenixlaravel.loc http://127.0.0.1:3000 http://localhost"

# ===== BROADCAST DRIVER =====
BROADCAST_DRIVER=reverb

# ===== REVERB SERVER CONFIG =====

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8070
REVERB_APP_KEY=reverb_app_key_public
REVERB_APP_SECRET=reverb_app_secret_private
REVERB_APP_ID=reverb_app_main
REVERB_HOST=fenixlaravel.loc
REVERB_PORT=8070
REVERB_SCHEME=http
REVERB_SERVER_PATH=/ws

# ===== CLIENT-SIDE CONFIG (Vite) =====
VITE_REVERB_APP_KEY=reverb_app_key_public
VITE_REVERB_HOST=fenixlaravel.loc
VITE_REVERB_PORT=8070
VITE_REVERB_SCHEME=http

# ===== LEGACY PUSHER COMPATIBILITY =====
PUSHER_APP_ID=reverb_app_main
PUSHER_APP_KEY=reverb_app_key_public
PUSHER_APP_SECRET=reverb_app_secret_private
PUSHER_APP_CLUSTER=reverb

# ===== Laravel Mix  =====
MIX_PUSHER_APP_KEY="reverb_app_key_public"
MIX_PUSHER_APP_CLUSTER="reverb"
